  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Nos journalistes ont re\xE7u un enregistrement audio authentifi\xE9, transmis
    par une source interne \xE0 l\u2019entreprise On\xE8melargeant. Cet enregistrement
    ferait \xE9tat d\u2019une r\xE9cente r\xE9union tenue entre le PDG du groupe
    et plusieurs dirigeants du pays. Cette rencontre aurait eu lieu dans le cadre
    officiel de la \u201Ccroissance \xE9conomique nationale\u201D. Or, On\xE8melargeant
    conna\xEEt une forte explosion de son chiffre d\u2019affaires depuis ces derni\xE8res
    ann\xE9es et chercherait \xE0 \xE9tendre ses activit\xE9s sur notre territoire.
    Par ailleurs, plusieurs paysans vivant \xE0 proximit\xE9 de Soycampesino affirment
    avoir observ\xE9 des convois de camions de la marque Chocolat de Mathilde. \r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
